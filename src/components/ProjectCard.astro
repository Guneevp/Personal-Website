---
import { siteConfig } from "../config";

export type Project = {
  name: string;
  description: string;
  link?: string;
  github?: string;
  image?: string;
  video?: string;
  videoPoster?: string;
  skills?: string[];
};

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;

const githubHref = project.github ?? project.link;
const hasImage = Boolean(project.image);
---

<details class="proj-card group">
  <summary class="proj-card__summary">
    <div class="proj-card__media">
      {
        hasImage ? (
          <img
            src={project.image}
            alt={`Preview of ${project.name}`}
            loading="lazy"
            decoding="async"
            class="proj-card__img"
          />
        ) : (
          <div
            class="proj-card__placeholder"
            style={`background: linear-gradient(135deg, color-mix(in srgb, ${siteConfig.accentColor} 35%, #e5e7eb), #e5e7eb)`}
            aria-hidden="true"
          >
            <span class="font-mono text-sm font-medium text-white/90">
              {String(index + 1).padStart(2, "0")}
            </span>
          </div>
        )
      }
    </div>

    <div class="proj-card__content">
      <div class="flex items-start justify-between gap-3">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 sm:text-xl">
          {project.name}
        </h3>
        <div class="flex shrink-0 items-center gap-1.5">
          {
            githubHref && (
              <a
                href={githubHref}
                target="_blank"
                rel="noopener noreferrer"
                class="project-action"
                aria-label={`${project.name} on GitHub`}
                title="GitHub"
                onclick="event.stopPropagation()"
              >
                <svg
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
                </svg>
              </a>
            )
          }
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="proj-card__chevron h-5 w-5 text-gray-400"
            aria-hidden="true"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M6 9l6 6l6 -6" />
          </svg>
        </div>
      </div>

      <p class="proj-card__desc mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-400 sm:text-base">
        {project.description}
      </p>

      {
        project.skills && project.skills.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-1.5 sm:mt-4">
            {project.skills.map((skill) => (
              <li>
                <span class="rounded-md bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700 dark:bg-gray-800 dark:text-gray-300">
                  {skill}
                </span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </summary>
</details>

<style>
  .proj-card {
    border-radius: 0.75rem;
    border: 1px solid rgb(229 231 235 / 0.9);
    background: white;
    overflow: hidden;
  }

  :global(.dark) .proj-card {
    border-color: rgb(31 41 55 / 0.9);
    background: rgb(17 24 39 / 0.8);
  }

  .proj-card__summary {
    display: grid;
    grid-template-columns: 1fr;
    cursor: pointer;
    list-style: none;
  }

  .proj-card__summary::-webkit-details-marker {
    display: none;
  }

  @media (min-width: 640px) {
    .proj-card:not([open]) .proj-card__summary {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: stretch;
    }
  }

  .proj-card[open] .proj-card__summary {
    grid-template-columns: 1fr;
  }

  .proj-card__media {
    overflow: hidden;
    min-height: 10rem;
  }

  .proj-card__img,
  .proj-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .proj-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 10rem;
  }

  .proj-card:not([open]) .proj-card__img,
  .proj-card:not([open]) .proj-card__placeholder {
    aspect-ratio: 16 / 10;
  }

  @media (min-width: 640px) {
    .proj-card:not([open]) .proj-card__media {
      min-height: 100%;
    }

    .proj-card:not([open]) .proj-card__img,
    .proj-card:not([open]) .proj-card__placeholder {
      aspect-ratio: auto;
      min-height: 14rem;
    }
  }

  .proj-card[open] .proj-card__img,
  .proj-card[open] .proj-card__placeholder {
    aspect-ratio: 16 / 9;
    min-height: 0;
  }

  .proj-card__content {
    padding: 1.25rem;
  }

  @media (min-width: 640px) {
    .proj-card__content {
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }

  .proj-card:not([open]) .proj-card__desc {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .proj-card__chevron {
    transition: transform 0.2s ease;
  }

  .proj-card[open] .proj-card__chevron {
    transform: rotate(180deg);
  }
</style>
