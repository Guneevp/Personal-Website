---
import { siteConfig } from "../config";

const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{
  hasEducation && (
    <section id="education" class="content-section">
      <div class="mx-auto w-full max-w-4xl px-6 sm:px-8">
        <header class="section-header">
          <h2 class="section-title">Education</h2>
          <div
            class="section-accent"
            style={`background-color: ${siteConfig.accentColor}`}
            aria-hidden="true"
          />
        </header>

        <ul class="space-y-6">
          {siteConfig.education.map((edu) => (
            <li>
              <article class="flex gap-8 sm:gap-18">
                {edu.image && (
                  <img
                    src={edu.image}
                    alt=""
                    width="200"
                    height="200"
                    class="h-40 w-auto shrink-0 rounded-xl object-contain object-left sm:h-52"
                  />
                )}
                <div class="min-w-0 flex-1 self-center">
                  <h3 class="text-xl font-semibold tracking-tight text-gray-900 dark:text-gray-100 sm:text-2xl">
                    {edu.school}
                  </h3>
                  <p
                    class="mt-1 text-base font-medium sm:text-lg"
                    style={{ color: siteConfig.accentColor }}
                  >
                    {edu.degree}
                    {edu.dateRange && (
                      <span class="font-normal text-gray-500 dark:text-gray-400">
                        {" "}
                        · {edu.dateRange}
                      </span>
                    )}
                  </p>
                  {edu.description && (
                    <p class="mt-3 text-base leading-relaxed text-gray-600 dark:text-gray-400 sm:text-lg">
                      {edu.description}
                    </p>
                  )}
                </div>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
