---
import { siteConfig } from "../config";
import SectionLayout from "./SectionLayout.astro";

const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{
  hasEducation && (
    <SectionLayout id="education" title="Education">
      <ol class="space-y-6">
        {siteConfig.education.map((edu) => (
          <li>
            <article class="entry-card">
              <header class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                <div>
                  <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">
                    {edu.degree}
                  </h3>
                  <p
                    class="text-base font-medium"
                    style={{ color: siteConfig.accentColor }}
                  >
                    {edu.school}
                  </p>
                </div>
                <time class="entry-meta shrink-0">{edu.dateRange}</time>
              </header>

              <ul class="entry-list">
                {edu.achievements.map((achievement) => (
                  <li>{achievement}</li>
                ))}
              </ul>
            </article>
          </li>
        ))}
      </ol>
    </SectionLayout>
  )
}
