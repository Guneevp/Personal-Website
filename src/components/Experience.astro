---
import { siteConfig } from "../config";
import SectionLayout from "./SectionLayout.astro";

const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <SectionLayout id="experience" title="Experience">
      <ol class="relative space-y-8 border-s-2 border-gray-200 ps-7 dark:border-gray-800 sm:ps-8">
        {siteConfig.experience.map((exp) => (
          <li class="relative">
            <span
              class="absolute -start-[9px] top-2 h-2.5 w-2.5 rounded-full ring-4 ring-light-bg dark:ring-gray-950"
              style={{ backgroundColor: siteConfig.accentColor }}
              aria-hidden="true"
            />
            <article class="entry-card !shadow-none">
              <header class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                <div>
                  <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">
                    {exp.title}
                  </h3>
                  <p
                    class="text-base font-medium"
                    style={{ color: siteConfig.accentColor }}
                  >
                    {exp.company}
                  </p>
                </div>
                <time class="entry-meta shrink-0">{exp.dateRange}</time>
              </header>

              <ul class="entry-list">
                {exp.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </article>
          </li>
        ))}
      </ol>
    </SectionLayout>
  )
}
