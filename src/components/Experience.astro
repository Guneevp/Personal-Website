---
import { siteConfig } from "../config";

const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <section id="experience" class="content-section">
      <div class="mx-auto w-full max-w-4xl px-6 sm:px-8">
        <header class="section-header">
          <h2 class="section-title">Experience</h2>
          <div
            class="section-accent"
            style={`background-color: ${siteConfig.accentColor}`}
            aria-hidden="true"
          />
        </header>

        <ul class="divide-y divide-gray-200/80 dark:divide-gray-800/80">
          {siteConfig.experience.map((exp) => (
            <li>
              <details class="exp-row group">
                <summary class="exp-row__summary">
                  {"image" in exp && exp.image ? (
                    <img
                      src={exp.image}
                      alt=""
                      width="64"
                      height="64"
                      class="h-14 w-14 shrink-0 rounded-lg object-contain sm:h-16 sm:w-16"
                    />
                  ) : (
                    <span
                      class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg border sm:h-16 sm:w-16"
                      style={`color: ${siteConfig.accentColor}; border-color: color-mix(in srgb, ${siteConfig.accentColor} 25%, transparent)`}
                      aria-hidden="true"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-7 w-7"
                      >
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M3 7m0 2a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2z" />
                        <path d="M8 7v-2a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v2" />
                        <path d="M12 12l0 .01" />
                        <path d="M3 13a20 20 0 0 0 18 0" />
                      </svg>
                    </span>
                  )}

                  <div class="min-w-0 flex-1">
                    <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100 sm:text-lg">
                      {exp.title}
                    </h3>
                    <p class="truncate text-sm text-gray-500 dark:text-gray-400">
                      {exp.company}
                    </p>
                  </div>

                  <time class="hidden shrink-0 text-sm text-gray-500 dark:text-gray-400 sm:block">
                    {exp.dateRange}
                  </time>

                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="exp-row__chevron h-5 w-5 shrink-0 text-gray-400"
                    aria-hidden="true"
                  >
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M6 9l6 6l6 -6" />
                  </svg>
                </summary>

                <div class="exp-row__body">
                  <time class="mb-3 block text-sm text-gray-500 dark:text-gray-400 sm:hidden">
                    {exp.dateRange}
                  </time>
                  <ul class="entry-list !mt-0">
                    {exp.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                </div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .exp-row__summary {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding-block: 1rem;
    cursor: pointer;
    list-style: none;
  }

  .exp-row__summary::-webkit-details-marker {
    display: none;
  }

  .exp-row__chevron {
    transition: transform 0.2s ease;
  }

  .exp-row[open] .exp-row__chevron {
    transform: rotate(180deg);
  }

  .exp-row__body {
    padding-bottom: 1.25rem;
    padding-inline-start: 4.375rem; /* logo 3.5rem + gap */
  }

  @media (min-width: 640px) {
    .exp-row__summary {
      gap: 1rem;
      padding-block: 1.125rem;
    }

    .exp-row__body {
      padding-inline-start: 5rem; /* logo 4rem + gap */
    }
  }
</style>
